# Google Gemini API key (aistudio.google.com -> Get API key)
GEMINI_API_KEY=your_key_here

# Zendesk Help Center base URL (public, no auth needed)
ZENDESK_BASE_URL=https://support.optisigns.com

# Name of the Gemini File Search store (created on first run if missing)
FILE_SEARCH_STORE_NAME=optibot-kb
